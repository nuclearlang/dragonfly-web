// Tests of the characters component: the repository is a mock; everything else is the real code.
character(name: string, status: string) Character
  Character(
    id = 1,
    name = name,
    status = status,
    species = "Human",
    gender = "Male",
    origin = Origin(name = "Earth", url = ""),
    image = "",
    episode = [],
    created = "",
  )

page() Page<Character>
  Page(
    info = PageInfo(count = 2, pages = 1),
    results = [character("Rick", "Alive"), character("Birdperson", "Dead")],
  )

@mock([CharacterRepository])
CharactersTest
  beforeEach()
    when(CharacterRepository.getPage).thenReturn(Ok(page()))

  @test("GetPageUseCase keeps only the alive characters")
  aliveOnly()
    result = ~GetPageUseCase.exec(1)
    expect(okOf(result)).toEqual([character("Rick", "Alive")])

  @test("a failed request is an error of the component")
  failure()
    when(CharacterRepository.getPage).thenReturn(Err(CharacterError(message = "down")))
    expect(errOf(~CharactersComponent.getPage(2))).toEqual(CharacterError(message = "down"))

  @states("the manager loads the alive characters", expect = [CharactersState.loading(), CharactersState.full([character("Rick", "Alive")])])
  loadsPage(manager: CharactersManager)
    ~manager.loadPage(1)

  @widget("the list shows the alive characters")
  showsList()
    renderScreen(CharacterListScreen())
    ~screen.findByText("Rick")
    expect(screen.queryByText("Birdperson")).toBeNull()
